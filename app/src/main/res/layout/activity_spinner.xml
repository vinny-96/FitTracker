<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5FBFF"
    tools:context=".spinner">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrar entrenamiento"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#164E63" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Completa los datos y pulsa Registrar entrenamiento."
                android:textSize="15sp"
                android:textColor="#374151" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tipo de entrenamiento"
                android:textSize="18sp"
                android:textColor="#000000" />

            <Spinner
                android:id="@+id/spEntrenamiento"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <EditText
                android:id="@+id/etMinutos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Duración en minutos"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="#000000"
                android:textColorHint="#616161" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Intensidad"
                android:textSize="18sp"
                android:textColor="#000000" />

            <RadioGroup
                android:id="@+id/rgIntensidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbBaja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Baja"
                    android:textColor="#000000" />

                <RadioButton
                    android:id="@+id/rbMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Media"
                    android:textColor="#000000" />

                <RadioButton
                    android:id="@+id/rbAlta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alta"
                    android:textColor="#000000" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Aspectos completados"
                android:textSize="18sp"
                android:textColor="#000000" />

            <CheckBox
                android:id="@+id/cbCalentamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calentamiento realizado"
                android:textColor="#000000" />

            <CheckBox
                android:id="@+id/cbHidratacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hidratación adecuada"
                android:textColor="#000000" />

            <CheckBox
                android:id="@+id/cbEstiramiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estiramiento final"
                android:textColor="#000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Esfuerzo percibido (1 a 5)"
                android:textSize="18sp"
                android:textColor="#000000" />

            <RatingBar
                android:id="@+id/ratingEsfuerzo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1"
                android:rating="1" />

            <TextView
                android:id="@+id/tvProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Meta diaria: 0 / 60 minutos (0%)"
                android:textSize="16sp"
                android:textColor="#000000" />

            <ProgressBar
                android:id="@+id/progresoDiario"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="60"
                android:progress="0"
                android:progressTint="#0891B2" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnRegistrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:minHeight="52dp"
        android:text="Registrar entrenamiento"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0891B2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Sesiones registradas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#164E63" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSesiones"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false" />

</LinearLayout>